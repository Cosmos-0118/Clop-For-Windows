<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ClopWindows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ClopWindows.App.Localization"
    xmlns:infra="clr-namespace:ClopWindows.App.Infrastructure"
    xmlns:vm="clr-namespace:ClopWindows.App.ViewModels"
    Title="Clop for Windows"
        Width="1040"
        Height="680"
        MinWidth="860"
        MinHeight="540"
    Padding="{DynamicResource Spacing.WindowPadding}"
    Background="{DynamicResource Brush.WindowBackground}"
    FontFamily="{DynamicResource Font.Body}">
    <Window.Resources>
        <infra:AdaptiveSidebarWidthConverter x:Key="AdaptiveSidebarWidthConverter"
                                             MinWidth="220"
                                             MaxWidth="360"
                                             WidthRatio="0.24"/>

        <Style x:Key="VectorBorderContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.NavigationBorder}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PillNavButton" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationTitle}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.NavigationItemBorder}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Container"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="{DynamicResource Brush.NavigationItemHoverBackground}"/>
                                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource Brush.NavigationItemSelectedBorder}"/>
                                <Setter TargetName="Container" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.22" ShadowDepth="0" Color="#FF000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource Brush.NavigationIndicator}"/>
                                <Setter TargetName="Container" Property="Background" Value="{DynamicResource Brush.NavigationItemSelectedBackground}"/>
                                <Setter TargetName="Container" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" Opacity="0.28" ShadowDepth="0" Color="#FF000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Container" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                CornerRadius="18"
                                Background="{DynamicResource Brush.SurfaceBackground}"
                                BorderBrush="{DynamicResource Brush.NavigationBorder}"
                                BorderThickness="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.NavigationIndicator}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemSelectedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarListItemStyle}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="AdaptiveSidebarCardStyle" TargetType="Border" BasedOn="{StaticResource VectorBorderContainer}">
            <Setter Property="Margin" Value="{DynamicResource Spacing.SidebarMargin}"/>
            <Setter Property="Padding" Value="{DynamicResource Spacing.ContentPadding}"/>
            <Setter Property="Width">
                <Setter.Value>
                    <Binding Path="ActualWidth"
                             RelativeSource="{RelativeSource AncestorType=Window}"
                             Converter="{StaticResource AdaptiveSidebarWidthConverter}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarInnerPanel" TargetType="Border" BasedOn="{StaticResource VectorBorderContainer}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ContentBackground}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="0"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
            Background="{DynamicResource Brush.ContentBackground}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AdaptiveSidebarCardStyle}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="14" BorderThickness="3" BorderBrush="{DynamicResource Brush.NavigationBorder}" Background="{DynamicResource Brush.SurfaceBackground}">
                            <Image Source="pack://application:,,,/ClopWindows;component/Assets/Brand/logo.ico"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Clop" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.NavigationTitle}"/>
                            <TextBlock Text="for windows" FontSize="12.5" Foreground="{DynamicResource Brush.NavigationSubtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,0,0,14"
                        CornerRadius="20"
                        Padding="6"
                        BorderThickness="3"
                        BorderBrush="{DynamicResource Brush.NavigationBorder}"
                        Background="{DynamicResource Brush.SurfaceBackground}">
                    <UniformGrid Columns="3">
                        <ToggleButton Content="Guide" Command="{Binding ShowOnboardingCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillNavButton}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Onboarding}">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ToggleButton Content="Optimize" Command="{Binding ShowCompareCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillNavButton}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Compare}">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ToggleButton Content="Settings" Command="{Binding ShowSettingsCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillNavButton}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Settings}">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </UniformGrid>
                </Border>

                <Grid Grid.Row="2">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarInnerPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Compare}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Recent Results" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}" Margin="0,0,0,12"/>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Compare.RecentItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" BorderBrush="{DynamicResource Brush.NavigationBorder}" BorderThickness="3" CornerRadius="18" Padding="12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding SizeSummary}" FontSize="11.5" Foreground="{DynamicResource Brush.NavigationSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <Button Grid.Row="2"
                                                                Content="Show in folder"
                                                                Command="{Binding DataContext.Compare.OpenRecentItemFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding OutputPath}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,10,0,0"
                                                                Padding="10,4"
                                                                FontSize="11.5"
                                                                Visibility="Collapsed">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="optimize something to see results here"
                                           Foreground="{DynamicResource Brush.NavigationSubtitle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="18">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Compare.RecentItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarInnerPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Settings}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}" Margin="0,0,0,12"/>
                            <ListBox ItemsSource="{Binding CurrentView.SettingsSections}"
                                     SelectedItem="{Binding CurrentView.SelectedSettingsSectionItem}"
                                     Style="{StaticResource SidebarListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarInnerPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Onboarding}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Guide" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}" Margin="0,0,0,12"/>
                            <ListBox ItemsSource="{Binding CurrentView.Steps}"
                                     SelectedItem="{Binding CurrentView.SelectedStep}"
                                     Style="{StaticResource SidebarListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NavigationTitle}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Button Grid.Column="2"
            Width="42"
            Height="42"
            MinWidth="42"
            MinHeight="42"
            Padding="0"
                VerticalAlignment="Center"
            HorizontalAlignment="Left"
                Background="{DynamicResource Brush.ContentBackground}"
                BorderBrush="{DynamicResource Brush.NavigationBorder}"
                BorderThickness="4"
            FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.NavigationTitle}"
                Cursor="Hand"
                Command="{Binding ToggleSidebarCommand}"
                Panel.ZIndex="20">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="-19,0,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Margin" Value="14,0,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="999"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2039;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Text" Value="&#x203A;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <Border Grid.Column="2" Margin="0,14,14,14" Padding="28" Background="{DynamicResource Brush.ContentBackground}" Style="{StaticResource VectorBorderContainer}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>
