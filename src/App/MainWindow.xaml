<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Squish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Squish.App.Localization"
        xmlns:vm="clr-namespace:Squish.App.ViewModels"
        Title="Squish"
        Width="1100"
        Height="720"
        MinWidth="560"
        MinHeight="460"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.PrimaryText}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="13">
    <Window.Resources>
        <!-- Primary navigation entry. Content is the label, Tag is the Segoe Fluent glyph. -->
        <Style x:Key="NavItem" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationSubtitle}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Rounded}" />
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph"
                                           Style="{StaticResource Text.Icon}"
                                           Width="18"
                                           Text="{TemplateBinding Tag}" />
                                <ContentPresenter x:Name="Label"
                                                  Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationTitle}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationTitle}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSidebarRail}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Chrome" Property="Padding" Value="0" />
                                <Setter TargetName="Glyph" Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="ToolTipService.IsEnabled" Value="True" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nested entries shown under the active primary item (settings sections, guide steps). -->
        <Style x:Key="SubNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationSubtitle}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Rounded}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationTitle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.NavigationItemSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.NavigationTitle}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubNavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="19,2,0,8" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubNavItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- Guide line linking the nested items to their parent. -->
                        <Border BorderBrush="{DynamicResource Brush.NavigationBorder}" BorderThickness="1,0,0,0" Padding="9,0,0,0">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.NavigationBackground}"
                BorderBrush="{DynamicResource Brush.NavigationBorder}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="{DynamicResource Layout.SidebarWidth}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarRail}" Value="True">
                            <Setter Property="Width" Value="{DynamicResource Layout.SidebarRailWidth}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="10,14,10,10">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="32" Margin="6,0,0,18">
                    <Image Source="{StaticResource Image.SquishLogo}" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc app.name}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.NavigationTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarRail}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Collapse / expand (hidden when the window is too narrow to expand). -->
                <Button DockPanel.Dock="Bottom"
                        HorizontalAlignment="Left"
                        Margin="4,8,0,0"
                        Command="{Binding ToggleSidebarCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE8A0;" />
                            <Setter Property="ToolTip" Value="{loc:Loc navigation.collapse}" />
                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc navigation.collapse}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Content" Value="&#xE89F;" />
                                    <Setter Property="ToolTip" Value="{loc:Loc navigation.expand}" />
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc navigation.expand}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel AutomationProperties.Name="{loc:Loc navigation.section.label}">
                        <ToggleButton Content="{loc:Loc navigation.compare.title}"
                                      Tag="&#xE945;"
                                      Command="{Binding ShowCompareCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource NavItem}">
                                    <Setter Property="IsChecked" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Compare}">
                                            <Setter Property="IsChecked" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <ToggleButton Content="{loc:Loc navigation.onboarding.title}"
                                      Tag="&#xE736;"
                                      Command="{Binding ShowOnboardingCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource NavItem}">
                                    <Setter Property="IsChecked" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Onboarding}">
                                            <Setter Property="IsChecked" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ListBox ItemsSource="{Binding CurrentView.Steps}"
                                 SelectedItem="{Binding CurrentView.SelectedStep}"
                                 AutomationProperties.HelpText="{loc:Loc onboarding.steps.list.help}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource SubNavList}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Onboarding}" />
                                                <Condition Binding="{Binding IsSidebarRail}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ToggleButton Content="{loc:Loc navigation.settings.title}"
                                      Tag="&#xE713;"
                                      Command="{Binding ShowSettingsCommand}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource NavItem}">
                                    <Setter Property="IsChecked" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Settings}">
                                            <Setter Property="IsChecked" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ListBox ItemsSource="{Binding CurrentView.SettingsSections}"
                                 SelectedItem="{Binding CurrentView.SelectedSettingsSectionItem}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource SubNavList}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedItem.Section}" Value="{x:Static vm:MainSection.Settings}" />
                                                <Condition Binding="{Binding IsSidebarRail}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1"
                        Focusable="False"
                        Background="{DynamicResource Brush.ContentBackground}"
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
