<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shell -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Brush.NavigationBorder" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="Brush.NavigationTitle" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.NavigationSubtitle" Color="#FF666666" />
    <SolidColorBrush x:Key="Brush.NavigationItemBorder" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBorder" Color="#FFDADADA" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBackground" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="Brush.NavigationItemHoverBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.NavigationIndicator" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.NavigationAccentGlow" Color="#14171717" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="#FFFFFFFF" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceSecondaryBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Brush.SurfaceBorder" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="Brush.SurfaceAltBorder" Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="Brush.CardHoverBackground" Color="#FFFAFAFA" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.PrimaryText" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="Brush.MutedText" Color="#FF8F8F8F" />
    <SolidColorBrush x:Key="Brush.PlaceholderText" Color="#FFA8A8A8" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush.FieldBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Brush.FieldHoverBorder" Color="#FFC4C4C4" />
    <SolidColorBrush x:Key="Brush.FieldForeground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.FieldPlaceholder" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlHoverBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="Brush.ControlPressedBackground" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Brush.ControlForeground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.GhostHoverBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.GhostPressedBackground" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonHoverBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonPressedBackground" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.DisabledForeground" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="#FFDCDCDC" />
    <SolidColorBrush x:Key="Brush.SwitchTrackHover" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Brush.SwitchTrackOn" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.SwitchThumb" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.BadgeBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FF4D4D4D" />
    <SolidColorBrush x:Key="Brush.AccentBadgeBackground" Color="#FFE3F9EE" />
    <SolidColorBrush x:Key="Brush.AccentBadgeForeground" Color="#FF0B7A47" />
    <SolidColorBrush x:Key="Brush.KbdBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Brush.KbdBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Brush.DropZoneBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="Brush.DropZoneBorder" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBorder" Color="#FF8F8F8F" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PopupBorder" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#FF0070F3" />

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF0B7A47" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFB45309" />
    <SolidColorBrush x:Key="Brush.StatusDanger" Color="#FFD93036" />

    <!-- Floating HUD -->
    <SolidColorBrush x:Key="Brush.HudBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.HudCardBackground" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="Brush.HudCardBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Brush.HudTextPrimary" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.HudTextSecondary" Color="#FF666666" />
    <SolidColorBrush x:Key="Brush.HudProgress" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.HudProgressBackground" Color="#FFE8E8E8" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Brush.ScrollBar.Track" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#33000000" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#55000000" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbDrag" Color="#77000000" />
</ResourceDictionary>
