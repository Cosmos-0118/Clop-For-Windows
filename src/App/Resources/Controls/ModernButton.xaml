<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keyboard focus ring shared by every interactive control (referenced with DynamicResource). -->
    <Style x:Key="FocusVisual.Rounded" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="-3"
                               RadiusX="8"
                               RadiusY="8"
                               StrokeThickness="2"
                               Stroke="{DynamicResource Brush.FocusRing}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One template for every button variant; colours come from the variant styles' setters and triggers. -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="SquishButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Rounded}" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>

    <!-- Default (secondary) button: bordered neutral surface. -->
    <Style x:Key="SecondaryButton" TargetType="ButtonBase" BasedOn="{StaticResource SquishButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.ControlForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ControlHoverBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ControlPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.DisabledBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledForeground}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary call to action: solid, high contrast. -->
    <Style x:Key="PrimaryButton" TargetType="ButtonBase" BasedOn="{StaticResource SquishButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryButtonForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButtonHoverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryButtonHoverBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButtonPressedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryButtonPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.DisabledBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DisabledBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledForeground}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless button for low-emphasis actions. -->
    <Style x:Key="GhostButton" TargetType="ButtonBase" BasedOn="{StaticResource SquishButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.SecondaryText}" />
        <Setter Property="Padding" Value="8,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.GhostHoverBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.GhostPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledForeground}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square ghost button that shows a single Segoe Fluent glyph. -->
    <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
</ResourceDictionary>
