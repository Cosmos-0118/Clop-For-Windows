<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <PathGeometry x:Key="Geometry.CheckMark" Figures="M 3.5 8.5 L 6.5 11.5 L 12.5 5" />
    <PathGeometry x:Key="Geometry.CheckDash" Figures="M 4 8 L 12 8" />

    <!-- Compact square checkbox for inline use. -->
    <Style x:Key="SquishCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.FieldBackground}"
                                BorderBrush="{DynamicResource Brush.FieldHoverBorder}"
                                BorderThickness="1">
                            <Path x:Name="Mark"
                                  Data="{StaticResource Geometry.CheckMark}"
                                  Stroke="{DynamicResource Brush.SwitchThumbOn}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Margin="-1"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.SecondaryText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SwitchTrackOn}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.SwitchTrackOn}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SwitchTrackOn}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.SwitchTrackOn}" />
                            <Setter TargetName="Mark" Property="Data" Value="{StaticResource Geometry.CheckDash}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Settings row: title (Content) and optional description (Tag) on the left, a toggle switch on the right.
        The whole row is the hit target, so clicking the label flips the switch.
    -->
    <Style x:Key="SettingSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.SettingRow}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  TextElement.FontWeight="Medium">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <TextBlock x:Name="Description"
                                           Text="{TemplateBinding Tag}"
                                           Margin="0,3,0,0"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.SecondaryText}" />
                            </StackPanel>
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SwitchTrack}">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Margin="2,0"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.SwitchThumb}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.SwitchTrackHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.SwitchTrackOn}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.SwitchThumbOn}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource SquishCheckBoxStyle}" />
</ResourceDictionary>
