<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Core palette -->
    <Color x:Key="Color.BlackOnyx">#FF050505</Color>
    <Color x:Key="Color.NeonGreen">#FF4FFFB0</Color>
    <Color x:Key="Color.SignalRed">#FFF45D5D</Color>
    <Color x:Key="Color.EmberOrange">#FFFF8A3D</Color>
    <Color x:Key="Color.RoyalPurple">#FF8C5BFF</Color>
    <Color x:Key="Color.Midnight">#FF0F172A</Color>
    <Color x:Key="Color.Slate">#FF1F2937</Color>
    <Color x:Key="Color.Glass">#CC0B1120</Color>
    <Color x:Key="Color.SoftWhite">#FFF8FAFC</Color>
    <Color x:Key="Color.Plaster">#FFF2F4F7</Color>
    <Color x:Key="Color.WarmGray">#FFEAECF0</Color>
    <Color x:Key="Color.CoolGray">#FFCBD5F5</Color>

    <!-- Typography -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Display">24</sys:Double>
    <sys:Double x:Key="FontSize.Title">18</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>

    <!-- Layout tokens -->
    <sys:Double x:Key="Layout.SidebarWidth">232</sys:Double>
    <sys:Double x:Key="Layout.SidebarRailWidth">60</sys:Double>
    <sys:Double x:Key="Layout.ContentMaxWidth">760</sys:Double>
    <sys:Double x:Key="Layout.ContentMaxWidthWide">920</sys:Double>
    <sys:Double x:Key="Layout.ControlHeight">32</sys:Double>
    <Thickness x:Key="Spacing.CardPadding">20</Thickness>
    <Thickness x:Key="Spacing.Panel">0,16,0,0</Thickness>
    <Thickness x:Key="Spacing.WindowPadding">0</Thickness>
    <Thickness x:Key="Spacing.ContentPadding">40,32,40,40</Thickness>
    <Thickness x:Key="Spacing.ContentPaddingCompact">20,20,20,28</Thickness>
    <Thickness x:Key="Spacing.SettingRow">16,14</Thickness>
    <Thickness x:Key="Spacing.Section">0,12,0,12</Thickness>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Hud">16</CornerRadius>
    <!-- Half the height of an 11-12px badge. WPF draws elliptical corners when a radius exceeds half the element's height, so never use 999 here. -->
    <CornerRadius x:Key="Radius.Pill">9</CornerRadius>
</ResourceDictionary>
