<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shell -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.NavigationBorder" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.NavigationTitle" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.NavigationSubtitle" Color="#FFA1A1A1" />
    <SolidColorBrush x:Key="Brush.NavigationItemBorder" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBackground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.NavigationItemHoverBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.NavigationIndicator" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.NavigationAccentGlow" Color="#14EDEDED" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="#FF0A0A0A" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="#FF111111" />
    <SolidColorBrush x:Key="Brush.SurfaceSecondaryBackground" Color="#FF0F0F0F" />
    <SolidColorBrush x:Key="Brush.SurfaceBorder" Color="#FF242424" />
    <SolidColorBrush x:Key="Brush.SurfaceAltBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FF111111" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FF242424" />
    <SolidColorBrush x:Key="Brush.CardHoverBackground" Color="#FF161616" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.PrimaryText" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="#FFA1A1A1" />
    <SolidColorBrush x:Key="Brush.MutedText" Color="#FF7C7C7C" />
    <SolidColorBrush x:Key="Brush.PlaceholderText" Color="#FF6B6B6B" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush.FieldBackground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.FieldHoverBorder" Color="#FF454545" />
    <SolidColorBrush x:Key="Brush.FieldForeground" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.FieldPlaceholder" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.ControlHoverBackground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.ControlPressedBackground" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.ControlForeground" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.GhostHoverBackground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.GhostPressedBackground" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonBackground" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonHoverBackground" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonPressedBackground" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonForeground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.DisabledForeground" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.SwitchTrackHover" Color="#FF404040" />
    <SolidColorBrush x:Key="Brush.SwitchTrackOn" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.SwitchThumb" Color="#FFA1A1A1" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.BadgeBackground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="#FFA1A1A1" />
    <SolidColorBrush x:Key="Brush.AccentBadgeBackground" Color="#1F4FFFB0" />
    <SolidColorBrush x:Key="Brush.AccentBadgeForeground" Color="#FF4FFFB0" />
    <SolidColorBrush x:Key="Brush.KbdBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="Brush.KbdBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.DropZoneBackground" Color="#FF0D0D0D" />
    <SolidColorBrush x:Key="Brush.DropZoneBorder" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBackground" Color="#FF141414" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBorder" Color="#FF7C7C7C" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="#FF141414" />
    <SolidColorBrush x:Key="Brush.PopupBorder" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#FF52A8FF" />

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF4FFFB0" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="Brush.StatusDanger" Color="#FFF45D5D" />

    <!-- Floating HUD -->
    <SolidColorBrush x:Key="Brush.HudBackground" Color="#F014161B" />
    <SolidColorBrush x:Key="Brush.HudCardBackground" Color="#FF252B33" />
    <SolidColorBrush x:Key="Brush.HudCardBorder" Color="#FF0A1B4A" />
    <SolidColorBrush x:Key="Brush.HudTextPrimary" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="Brush.HudTextSecondary" Color="#FFB4BAC4" />
    <SolidColorBrush x:Key="Brush.HudProgress" Color="#FFA899FF" />
    <SolidColorBrush x:Key="Brush.HudProgressBackground" Color="#332A2A3E" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Brush.ScrollBar.Track" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#60FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbDrag" Color="#80FFFFFF" />
</ResourceDictionary>
