<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shell -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.NavigationBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.NavigationBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.NavigationTitle" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.NavigationSubtitle" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.NavigationItemBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBorder" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.NavigationItemSelectedBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.NavigationItemHoverBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.NavigationIndicator" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.NavigationAccentGlow" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="{x:Static SystemColors.WindowColor}" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.SurfaceSecondaryBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.SurfaceBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.SurfaceAltBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.CardHoverBackground" Color="{x:Static SystemColors.ControlColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.PrimaryText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.MutedText" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.PlaceholderText" Color="{x:Static SystemColors.GrayTextColor}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush.FieldBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.FieldHoverBorder" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.FieldForeground" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.FieldPlaceholder" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.ControlHoverBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.ControlPressedBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Brush.ControlForeground" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Brush.GhostHoverBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.GhostPressedBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonHoverBackground" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonPressedBackground" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonForeground" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.DisabledForeground" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.SwitchTrackHover" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.SwitchTrackOn" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.SwitchThumb" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.SwitchThumbOn" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.SelectionBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.SelectionBorder" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.BadgeBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.BadgeForeground" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Brush.AccentBadgeBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentBadgeForeground" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.KbdBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.KbdBorder" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Brush.DropZoneBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.DropZoneBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBackground" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.DropZoneActiveBorder" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.PopupBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{x:Static SystemColors.HighlightColor}" />

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.StatusDanger" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- Floating HUD -->
    <SolidColorBrush x:Key="Brush.HudBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.HudCardBackground" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.HudCardBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.HudTextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.HudTextSecondary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.HudProgress" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.HudProgressBackground" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Brush.ScrollBar.Track" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbDrag" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
