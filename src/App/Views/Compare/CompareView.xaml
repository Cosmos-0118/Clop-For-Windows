<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Squish.App.Views.Compare.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Squish.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <!-- The whole page accepts drops, not just the drop zone. -->
    <Grid AllowDrop="True"
          Background="Transparent"
          DragOver="OnDragOver"
          DragEnter="OnDragEnter"
          DragLeave="OnDragLeave"
          Drop="OnDropFiles">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PageColumn}">
                        <Setter Property="MaxWidth" Value="880" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsWideLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="MaxWidth" Value="1040" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{loc:Loc navigation.compare.title}" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="{loc:Loc compare.subtitle}" Style="{StaticResource Text.PageSubtitle}" />
                    </StackPanel>

                    <!-- Drop zone -->
                    <Grid AutomationProperties.HelpText="{loc:Loc compare.dropHint.accessible}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Height" Value="300" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Height" Value="220" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle x:Name="DropZone"
                                   RadiusX="12"
                                   RadiusY="12"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="5 4"
                                   SnapsToDevicePixels="True"
                                   Fill="{DynamicResource Brush.DropZoneBackground}"
                                   Stroke="{DynamicResource Brush.DropZoneBorder}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.CardBackground}"
                                    BorderBrush="{DynamicResource Brush.CardBorder}"
                                    BorderThickness="1">
                                <TextBlock Style="{StaticResource Text.Icon}"
                                           FontSize="20"
                                           Text="&#xE898;"
                                           Foreground="{DynamicResource Brush.PrimaryText}" />
                            </Border>
                            <TextBlock Text="{loc:Loc compare.dropTitle}"
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.PrimaryText}" />
                            <TextBlock Text="{loc:Loc compare.dropSubtitle}"
                                       Style="{StaticResource Text.Body}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Padding="16,0"
                                    Content="{loc:Loc compare.browse}"
                                    Command="{Binding BrowseForFilesCommand}"
                                    AutomationProperties.Name="{loc:Loc compare.browse.automation}" />
                        </StackPanel>
                    </Grid>

                    <!-- Recent results -->
                    <DockPanel Margin="0,28,0,0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc compare.recent}" Style="{StaticResource Text.SectionLabel}" Margin="0" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource GhostButton}"
                                    MinHeight="28"
                                    Content="{loc:Loc compare.cancelActive}"
                                    Command="{Binding CancelActiveRequestsCommand}"
                                    AutomationProperties.Name="{loc:Loc compare.cancelActive.automation}"
                                    Visibility="{Binding HasActiveRequests, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                    <ItemsControl ItemsSource="{Binding RecentItems}"
                                                  AutomationProperties.HelpText="{loc:Loc compare.recent.list.help}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource Brush.Divider}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource Brush.BadgeBackground}">
                                                            <TextBlock Style="{StaticResource Text.Icon}"
                                                                       FontSize="14"
                                                                       Text="&#xE8A5;"
                                                                       Foreground="{DynamicResource Brush.SecondaryText}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding OutputPath}" />
                                                            <TextBlock Text="{Binding SizeSummary}"
                                                                       Style="{StaticResource Text.Caption}"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button x:Name="ShowInFolder"
                                                                Grid.Column="2"
                                                                Style="{StaticResource GhostButton}"
                                                                MinHeight="28"
                                                                Content="{loc:Loc compare.showInFolder}"
                                                                Opacity="0"
                                                                Command="{Binding DataContext.OpenRecentItemFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding OutputPath}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.CardHoverBackground}" />
                                                        <Setter TargetName="ShowInFolder" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger SourceName="ShowInFolder" Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ShowInFolder" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                <TextBlock Text="{loc:Loc compare.recent.empty}"
                                           Margin="16,18"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
