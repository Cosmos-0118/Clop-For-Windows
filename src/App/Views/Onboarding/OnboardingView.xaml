<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Squish.App.Views.Onboarding.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Squish.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PageColumn}">
            <StackPanel>
                <!-- Step switcher shown in place of the sidebar list when the sidebar is a rail. -->
                <ListBox ItemsSource="{Binding Steps}"
                         SelectedItem="{Binding SelectedStep}"
                         DisplayMemberPath="Title"
                         Margin="0,0,0,18"
                         AutomationProperties.HelpText="{loc:Loc onboarding.steps.list.help}">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource ChipList}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource Image.SquishLogo}" Width="48" Height="48" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <StackPanel>
                        <StackPanel Margin="24,22,24,20">
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding StepPosition}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedStep.Title}"
                                       Margin="0,12,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedStep.Description}"
                                       Style="{StaticResource Text.Body}"
                                       FontSize="13.5"
                                       Margin="0,6,0,0" />

                            <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding SelectedStep.Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Icon}"
                                                       FontSize="12"
                                                       VerticalAlignment="Top"
                                                       Margin="0,3,10,0"
                                                       Text="&#xE73E;"
                                                       Foreground="{DynamicResource Brush.StatusSuccess}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="24,14">
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Content="{loc:Loc onboarding.back}"
                                    Command="{Binding PreviousStepCommand}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{loc:Loc onboarding.next}" Command="{Binding NextStepCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        Content="{loc:Loc onboarding.cta}"
                                        Command="{Binding GetStartedCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
