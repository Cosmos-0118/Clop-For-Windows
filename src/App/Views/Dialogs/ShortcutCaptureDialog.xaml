<Window x:Class="Squish.App.Views.Dialogs.ShortcutCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Squish.App.Localization"
        Title="{loc:Loc shortcuts.capture.windowTitle}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.SurfaceBackground}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="24,22,24,20" MinWidth="320">
        <TextBlock Text="{loc:Loc shortcuts.capture.title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryText}" />
        <TextBlock x:Name="ScopeText" Margin="0,4,0,0" Style="{StaticResource Text.Body}" />

        <Border Margin="0,16,0,0" Style="{StaticResource Card}" Background="{DynamicResource Brush.SurfaceSecondaryBackground}" Padding="14,12">
            <StackPanel>
                <TextBlock x:Name="CurrentText" Style="{StaticResource Text.Title}" />
                <TextBlock x:Name="DefaultText" Margin="0,2,0,0" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{loc:Loc shortcuts.capture.instructions}" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc shortcuts.capture.disable}" Style="{StaticResource GhostButton}" Click="OnDisableClick" />
            <Button Content="{loc:Loc shortcuts.capture.cancel}" Click="OnCancelClick" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
