<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Squish.App.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Squish.App.Localization"
             xmlns:infra="clr-namespace:Squish.App.Infrastructure"
             xmlns:controls="clr-namespace:Squish.App.Controls"
             xmlns:core="clr-namespace:Squish.Core.Settings;assembly=Squish.Core"
             mc:Ignorable="d"
             PreviewMouseWheel="OnPreviewMouseWheel"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <infra:EqualsToVisibilityConverter x:Key="ShowWhenEquals" />

        <!-- Heading + description above a card group. -->
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionLabel}">
            <Setter Property="Margin" Value="0,28,0,2" />
        </Style>
        <Style x:Key="GroupDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Rows inside a card get a top divider, except the first one. -->
        <Style x:Key="ListRow" TargetType="Border" BasedOn="{StaticResource CardRow}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FolderRowTemplate">
            <Border Style="{StaticResource ListRow}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE8B7;" Foreground="{DynamicResource Brush.SecondaryText}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               Text="{Binding}"
                               ToolTip="{Binding}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.PrimaryText}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            MinHeight="28"
                            Content="{loc:Loc settings.automation.removeFolder}"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutRowTemplate">
            <Border Style="{StaticResource ListRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding DefaultBindingLabel}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Kbd}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentBinding}" />
                        </Border>
                        <Button Content="{loc:Loc settings.shortcuts.change}" Command="{Binding CaptureCommand}" MinHeight="28" Padding="10,0" />
                        <Button Content="{loc:Loc settings.shortcuts.reset}" Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}" MinHeight="28" Margin="4,0,0,0" />
                        <Button Content="{loc:Loc settings.shortcuts.clear}" Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" MinHeight="28" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PageColumn}">
            <StackPanel>
                <!-- Section switcher shown in place of the sidebar list when the sidebar is a rail. -->
                <ListBox ItemsSource="{Binding SettingsSections}"
                         SelectedItem="{Binding SelectedSettingsSectionItem}"
                         DisplayMemberPath="Title"
                         Margin="0,0,0,18">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource ChipList}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSidebarRail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <TextBlock Text="{Binding SelectedSettingsSectionTitle}" Style="{StaticResource Text.PageTitle}" />

                <!-- Appearance -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Appearance}">
                    <TextBlock Text="{loc:Loc settings.appearance.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <Border Style="{StaticResource CardRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ThemeLabel" Text="{loc:Loc settings.theme.mode}" Style="{StaticResource Text.Title}" />
                                    <TextBlock Text="{loc:Loc settings.theme.mode.subtitle}" Style="{StaticResource Text.Body}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="180"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedThemeOption}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" />
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- System -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=System}">
                    <TextBlock Text="{loc:Loc settings.system.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.system.runInBackground}"
                                      Tag="{loc:Loc settings.system.runInBackground.subtitle}"
                                      IsChecked="{Binding RunInBackground}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.system.openAtStartup}"
                                      Tag="{loc:Loc settings.system.openAtStartup.subtitle}"
                                      IsChecked="{Binding OpenAtStartup}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Floating HUD -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=FloatingHud}">
                    <TextBlock Text="{loc:Loc settings.floatingHud.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.floatingHud.show}"
                                      IsChecked="{Binding EnableFloatingResults}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.floatingHud.autoHide}"
                                      IsChecked="{Binding AutoHideFloatingResults}" />
                            <Border Style="{StaticResource Divider}" />
                            <Border Style="{StaticResource CardRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FloatingHudHideAfterLabel"
                                               Text="{loc:Loc settings.floatingHud.hideAfter}"
                                               Style="{StaticResource Text.Title}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 TextAlignment="Right"
                                                 Text="{Binding AutoHideFloatingResultsAfter, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=FloatingHudHideAfterLabel}"
                                                 AutomationProperties.HelpText="{loc:Loc settings.floatingHud.hideAfter.help}"
                                                 AutomationProperties.Name="{loc:Loc settings.autohide.seconds.accessible}" />
                                        <TextBlock Text="{loc:Loc settings.floatingHud.hideAfterSuffix}"
                                                   Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="FloatingHudPlacementLabel" Text="{loc:Loc settings.floatingHud.placementHeading}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{loc:Loc settings.floatingHud.placementDescription}" Style="{StaticResource GroupDescription}" />
                    <ListBox Style="{StaticResource OptionCardList}"
                             ItemsSource="{Binding FloatingHudPlacementOptions}"
                             SelectedValuePath="Placement"
                             SelectedValue="{Binding FloatingHudPlacement, Mode=TwoWay}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FloatingHudPlacementLabel}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:SmartWrapPanel MinColumnWidth="130" HorizontalSpacing="8" VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource OptionCardItem}">
                                <Setter Property="Padding" Value="12,9" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FloatingHudPlacementStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc settings.floatingHud.resetLayout}"
                                Command="{Binding ResetHudLayoutCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Clipboard}">
                    <TextBlock Text="{loc:Loc settings.clipboard.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.clipboard.optimiseImages}" IsChecked="{Binding EnableClipboardOptimiser}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.clipboard.copyBack}" IsChecked="{Binding AutoCopyToClipboard}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.clipboard.copyFilePath}" IsChecked="{Binding CopyImageFilePath}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.clipboard.optimiseVideos}" IsChecked="{Binding OptimiseVideoClipboard}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.clipboard.optimiseFileDrops}" IsChecked="{Binding OptimiseClipboardFileDrops}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Automation -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Automation}">
                    <TextBlock Text="{loc:Loc settings.automation.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.automation.watchImages}" IsChecked="{Binding EnableAutomaticImageOptimisations}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.automation.watchVideos}" IsChecked="{Binding EnableAutomaticVideoOptimisations}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,28,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc settings.automation.imageFoldersTitle}" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc settings.automation.folderSubtitle}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{loc:Loc settings.automation.addFolder}" Command="{Binding AddImageDirectoryCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding ImageDirectories}"
                                          Tag="{Binding RemoveImageDirectoryCommand}"
                                          ItemTemplate="{StaticResource FolderRowTemplate}" />
                            <TextBlock Text="{loc:Loc settings.automation.imageFoldersEmpty}"
                                       Margin="16,14"
                                       Visibility="{Binding ImageDirectories.Count, Converter={StaticResource ShowWhenEquals}, ConverterParameter=0}"
                                       Style="{StaticResource Text.Body}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,28,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc settings.automation.videoFoldersTitle}" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc settings.automation.folderSubtitle}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{loc:Loc settings.automation.addFolder}" Command="{Binding AddVideoDirectoryCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding VideoDirectories}"
                                          Tag="{Binding RemoveVideoDirectoryCommand}"
                                          ItemTemplate="{StaticResource FolderRowTemplate}" />
                            <TextBlock Text="{loc:Loc settings.automation.videoFoldersEmpty}"
                                       Margin="16,14"
                                       Visibility="{Binding VideoDirectories.Count, Converter={StaticResource ShowWhenEquals}, ConverterParameter=0}"
                                       Style="{StaticResource Text.Body}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Optimisation -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Optimisation}">
                    <TextBlock Text="{loc:Loc settings.optimisation.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.optimisation.aggressive}"
                                      Tag="{loc:Loc settings.optimisation.aggressive.subtitle}"
                                      IsChecked="{Binding AggressiveImageCompression}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.optimisation.downscale}"
                                      Tag="{loc:Loc settings.optimisation.downscale.subtitle}"
                                      IsChecked="{Binding DownscaleLargeImages}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.optimisation.forceFullImage}"
                                      Tag="{loc:Loc settings.optimisation.forceFullImage.subtitle}"
                                      IsChecked="{Binding ForceFullImageOptimisations}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc settings.optimisation.formats.title}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{loc:Loc settings.optimisation.formats.subtitle}" Style="{StaticResource GroupDescription}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.optimisation.webp}"
                                      Tag="{loc:Loc settings.optimisation.webp.subtitle}"
                                      IsChecked="{Binding AllowWebpOutput}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.optimisation.avif}"
                                      Tag="{loc:Loc settings.optimisation.avif.subtitle}"
                                      IsChecked="{Binding AllowAvifOutput}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc settings.optimisation.videoPreset.title}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{Binding VideoPresetSubtitle}" Style="{StaticResource GroupDescription}" />
                    <Border Style="{StaticResource Card}">
                        <Grid ClipToBounds="True">
                            <ListBox Style="{StaticResource RadioRowList}"
                                     ItemsSource="{Binding VideoEncoderPresetOptions}"
                                     SelectedItem="{Binding SelectedVideoEncoderPreset}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                                                <Border x:Name="RecommendedBadge" Style="{StaticResource Badge.Accent}" Margin="8,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="{loc:Loc settings.optimisation.videoPreset.recommended}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.SecondaryText}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Preset}" Value="{x:Static core:VideoEncoderPreset.Auto}">
                                                <Setter TargetName="RecommendedBadge" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Output -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Output}">
                    <TextBlock Text="{loc:Loc settings.output.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.output.replaceInPlace}"
                                      Tag="{loc:Loc settings.output.replaceInPlace.subtitle}"
                                      IsChecked="{Binding ReplaceOptimisedFilesInPlace}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}"
                                      Content="{loc:Loc settings.output.deleteConverted}"
                                      Tag="{loc:Loc settings.output.deleteConverted.subtitle}"
                                      IsChecked="{Binding DeleteOriginalAfterConversion}"
                                      IsEnabled="{Binding ReplaceOptimisedFilesInPlace}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preservation -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Preservation}">
                    <TextBlock Text="{loc:Loc settings.preservation.description}" Style="{StaticResource Text.PageSubtitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.preservation.preserveDates}" IsChecked="{Binding PreserveDates}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.preservation.stripMetadata}" IsChecked="{Binding StripMetadata}" />
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource SettingSwitch}" Content="{loc:Loc settings.preservation.preserveColorProfiles}" IsChecked="{Binding PreserveColorMetadata}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Shortcuts -->
                <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource ShowWhenEquals}, ConverterParameter=Shortcuts}">
                    <TextBlock Text="{loc:Loc settings.shortcuts.description}" Style="{StaticResource Text.PageSubtitle}" />

                    <TextBlock Text="{loc:Loc settings.shortcuts.app}" Style="{StaticResource Text.SectionLabel}" Margin="0,28,0,12" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding AppShortcutPreferences}"
                                      ItemTemplate="{StaticResource ShortcutRowTemplate}"
                                      AutomationProperties.HelpText="{loc:Loc settings.shortcuts.list.help}" />
                    </Border>

                    <TextBlock Text="{loc:Loc settings.shortcuts.global}" Style="{StaticResource Text.SectionLabel}" Margin="0,28,0,12" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding GlobalShortcutPreferences}"
                                      ItemTemplate="{StaticResource ShortcutRowTemplate}"
                                      AutomationProperties.HelpText="{loc:Loc settings.shortcuts.list.help}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
