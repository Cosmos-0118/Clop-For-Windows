<Window x:Class="Squish.App.Views.FloatingHud.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Squish.App.Localization"
        xmlns:viewModels="clr-namespace:Squish.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Squish Floating HUD"
        Background="{DynamicResource Brush.HudBackground}"
        Foreground="{DynamicResource Brush.HudTextPrimary}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="13"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="Height"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        MinWidth="{x:Static viewModels:FloatingHudViewModel.MinWindowWidth}"
        MaxWidth="{x:Static viewModels:FloatingHudViewModel.MaxWindowWidth}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MaxHeight="{Binding WindowHeight}"
        AutomationProperties.Name="{loc:Loc hud.title}">
    <!-- Height follows the content; the saved HUD height is the most it may grow to before the list scrolls. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HudProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.HudProgress}" />
            <Setter Property="Background" Value="{DynamicResource Brush.HudProgressBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.HudTextSecondary}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource Brush.HudCardBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header doubles as the drag handle. -->
            <Grid x:Name="TitleBar"
                  Background="Transparent"
                  Margin="14,8,8,8"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{StaticResource Image.SquishLogo}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{loc:Loc hud.title}" />
                <Border Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        Background="{DynamicResource Brush.HudCardBackground}"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Results.Count}" FontSize="11" Foreground="{DynamicResource Brush.HudTextSecondary}" />
                </Border>
                <Button Grid.Column="4"
                        Style="{StaticResource HudIconButton}"
                        Content="&#xE711;"
                        Click="OnHideClicked"
                        AutomationProperties.Name="{loc:Loc hud.hide.toggle}"
                        ToolTip="{loc:Loc hud.hide.tooltip}" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.HudCardBorder}" />

            <ScrollViewer Grid.Row="2"
                          Padding="6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl x:Name="ResultItemsControl"
                              ItemsSource="{Binding Results}"
                              AutomationProperties.LiveSetting="Polite"
                              AutomationProperties.Name="{loc:Loc hud.automation.name}"
                              AutomationProperties.HelpText="{loc:Loc hud.automation.help}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:FloatingResultViewModel}">
                            <Border x:Name="ResultCard"
                                    Padding="8"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip="{Binding Subtitle}"
                                    ToolTipService.InitialShowDelay="900"
                                    MouseLeftButtonDown="OnResultCardMouseLeftButtonDown"
                                    MouseLeftButtonUp="OnResultCardMouseLeftButtonUp"
                                    MouseMove="OnResultCardMouseMove"
                                    MouseLeave="OnResultCardMouseLeave">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.HudCardBackground}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32"
                                            Height="32"
                                            CornerRadius="7"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.HudCardBackground}"
                                            BorderBrush="{DynamicResource Brush.HudCardBorder}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="KindIcon"
                                                   Text="{Binding KindGlyph}"
                                                   FontFamily="{DynamicResource Font.Icons}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.HudTextSecondary}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusLine"
                                                   Text="{Binding StatusText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.HudTextSecondary}" />
                                        <ProgressBar Style="{StaticResource HudProgressBar}"
                                                     Margin="0,7,0,1"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Savings (or progress) at rest; actions while hovered. -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel x:Name="RestState" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Padding="7,2"
                                                    CornerRadius="{DynamicResource Radius.Pill}"
                                                    Background="{DynamicResource Brush.AccentBadgeBackground}"
                                                    Visibility="{Binding HasSavings, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding SavingsText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AccentBadgeForeground}" />
                                            </Border>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.HudTextSecondary}"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel x:Name="HoverActions" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button Style="{StaticResource HudIconButton}"
                                                    Content="&#xE71A;"
                                                    Command="{Binding CancelCommand}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.Name="{loc:Loc hud.cancel.button}"
                                                    ToolTip="{loc:Loc hud.cancel.tooltip}" />
                                            <Button Style="{StaticResource HudIconButton}"
                                                    Content="&#xE711;"
                                                    Command="{Binding DismissCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.StatusDanger}" />
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.StatusDanger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ResultCard}" Value="True">
                                    <Setter TargetName="RestState" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HoverActions" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="24,22,24,24" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE91B;"
                           FontFamily="{DynamicResource Font.Icons}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.HudTextSecondary}" />
                <TextBlock Text="{loc:Loc hud.empty.title}"
                           Margin="0,10,0,0"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:Loc hud.empty.description}"
                           Margin="0,4,0,0"
                           MaxWidth="260"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Brush.HudTextSecondary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
